# mount point   fstype  device                        device2  flags
# Logical partitions
/system_ext     ext4    system_ext                              flags=display=System_EXT
/system_dlkm    ext4    system_dlkm                             flags=display=System_DLKM
/vendor_dlkm    ext4    vendor_dlkm                             flags=display=Vendor_DLKM
/odm_dlkm       ext4    odm_dlkm                                flags=display=ODM_DLKM

# Userdata / metadata
/metadata       f2fs    /dev/block/by-name/metadata             flags=display="Metadata";backup=1;flashimg=1
/data           f2fs    /dev/block/by-name/userdata             flags=display="Data";backup=1

# Boot partitions
/boot           emmc    /dev/block/by-name/boot                 flags=slotselect
/init_boot      emmc    /dev/block/by-name/init_boot            flags=slotselect;display="Init Boot";backup=1;flashimg=1
/vendor_boot    emmc    /dev/block/by-name/vendor_boot          flags=slotselect;display="Vendor Boot";backup=1;flashimg=1
/dtbo           emmc    /dev/block/by-name/dtbo                 flags=slotselect;display="DTBO";backup=1;flashimg=1

# AVB partitions
/vbmeta         emmc    /dev/block/by-name/vbmeta               flags=slotselect;display="VBMeta";backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/by-name/vbmeta_system        flags=slotselect;display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor  emmc    /dev/block/by-name/vbmeta_vendor        flags=slotselect;display="VBMeta Vendor";backup=1;flashimg=1

# Persistent / EFS
/persist        ext4    /dev/block/by-name/persist              flags=display="Persist"
/nvdata         ext4    /dev/block/by-name/nvdata               flags=display="NVData"
/protect_f      ext4    /dev/block/by-name/protect1             flags=display="Protect1"
/protect_s      ext4    /dev/block/by-name/protect2             flags=display="Protect2"

# Modem / firmware
/modem          emmc    /dev/block/by-name/modem                flags=slotselect;backup=1;display="Modem"
/firmware       vfat    /dev/block/by-name/modem                flags=slotselect;display="Firmware";mounttodecrypt;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0"

# Removable storage
/storage        auto    /data/media/0                           flags=display="Internal Storage";backup=1;usermrf;fsflags="bind,utf8";removable
/usb_otg        vfat    /dev/block/sdg1   /dev/block/sdg        flags=display="USB-Storage";fsflags=utf8;storage;wipeingui;removable
