#
# Trimmed MTK musb-hdrc configfs USB setup for recovery (adb/mtp/fastbootd).
#

on post-fs
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor ${vendor.usb.vid:-0x0E8D}
    write /config/usb_gadget/g1/idProduct ${vendor.usb.pid:-0x201C}
    write /config/usb_gadget/g1/bcdDevice 0x0223
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/os_desc/use 1
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /config/usb_gadget/g1/functions/ffs.fastboot
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1
    mount functionfs fastboot /dev/usb-ffs/fastboot rmode=0770,fmode=0660,uid=1000,gid=1000
    setprop sys.usb.mtp.device_type 3
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 0

on property:sys.usb.config=none && property:sys.usb.configfs=1
    # Keep sys.usb.ffs.ready (adb) as-is: the adb functionfs mount and adbd
    # ep0 are never torn down across config switches, so clearing it would
    # leave the adb re-bind action waiting forever. MTP has its own ready
    # property which is cleared here and re-armed by the MTP server.
    setprop sys.usb.ffs.mtp.ready 0
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    # The UDC rebind after "none" is done by TWRP's Enable_MTP with retries
    # (the first bind fails with -19 on NX1 musb; a retry succeeds).
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=sideload
    # update_engine_sideload needs /metadata mounted to manage A/B snapshot
    # state, and it refuses to clean up stale snapshots while /system_root or
    # /postinstall is still mounted (leftover from a previous attempt).
    umount /system_root
    umount /postinstall
    mount f2fs /dev/block/by-name/metadata /metadata noatime nosuid nodev discard wait

on property:sys.usb.config=fastboot
    # Provide MTK's boot control HAL for fastbootd so slot info is available.
    start vendor.boot-mediatek

service vendor.boot-mediatek /vendor/bin/hw/android.hardware.boot-service.mediatek
    class early_hal
    user root
    group root
    seclabel u:r:hal_bootctl_default:s0
    interface aidl android.hardware.boot.IBootControl/default

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0x4EE7
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    write /config/usb_gadget/g1/idVendor 0x18D1
    write /config/usb_gadget/g1/idProduct 0x4EE7
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    # The AOSP "none" action killed adbd and released the UDC. Restart adbd
    # (it re-opens ffs.adb). The UDC bind itself (with -19 retries) is done
    # by TWRP's Enable_MTP (recovery domain), not from init.
    start adbd
    setprop sys.usb.state ${sys.usb.config}
