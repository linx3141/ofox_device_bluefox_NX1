+extern "C" void AIBinder_Class_setTransactionCodeToFunctionNameMap(
+        AIBinder_Class* clazz, const char* const* /*transactionCodeToFunctionMap*/,
+        size_t /*length*/) {
+    LOG_ALWAYS_FATAL_IF(clazz == nullptr,
+                        "setTransactionCodeToFunctionNameMap requires non-null clazz");
+    // No-op on purpose: this recovery's libbinder_ndk predates the API-36
+    // transaction code map, and wiring it through would require a newer
+    // libbinder (BBinder::setTransactionCodeMap). Newer vendor HALs only call
+    // this for trace name decoration, so ignoring it is safe.
+}
