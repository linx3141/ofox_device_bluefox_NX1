@@ -0,0 +1,21 @@
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+
+// This recovery's libc++ predates std::__1::__libcpp_verbose_abort. The
+// TrustKernel keymint/gatekeeper HALs (built against a newer libc++) import
+// this symbol, so provide a compatible definition to let them link.
+namespace std {
+inline namespace __1 {
+
+__attribute__((visibility("default")))
+void __libcpp_verbose_abort(char const* format, ...) {
+  va_list list;
+  va_start(list, format);
+  std::vfprintf(stderr, format, list);
+  va_end(list);
+  std::abort();
+}
+
+}  // inline namespace __1
+}  // namespace std
