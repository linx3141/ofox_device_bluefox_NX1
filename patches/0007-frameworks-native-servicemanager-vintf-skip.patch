 }
 
 static bool meetsDeclarationRequirements(const sp<IBinder>& binder, const std::string& name) {
+#ifdef RECOVERY_SERVICEMANAGER_NO_VINTF
+    // Recovery's vendor manifest (from the mounted read-only vendor) does not
+    // declare every TrustKernel HAL instance (e.g. secureclock/sharedsecret),
+    // so skip the VINTF gate for the recovery servicemanager only.
+    return true;
+#endif
     if (!Stability::requiresVintfDeclaration(binder)) {
         return true;
     }
